{
  "name": "anl-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "《AI는 거짓말을 하지 않는다》 Episode 01 웹 구현",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "predev": "python3 ../tools/sync_web_assets.py",
    "build": "tsc -b && vite build && node scripts/generate-service-worker.mjs",
    "prebuild": "python3 ../tools/sync_web_assets.py",
    "preview": "vite preview",
    "lint": "oxlint .",
    "typecheck": "tsc -b --force",
    "test": "vitest",
    "pretest:run": "python3 ../tools/sync_web_assets.py",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "pretest:e2e": "python3 ../tools/sync_web_assets.py",
    "test:e2e": "playwright test",
    "pretest:e2e:webkit": "python3 ../tools/sync_web_assets.py",
    "test:e2e:webkit": "playwright test --config playwright.webkit.config.ts",
    "pretest:qa:offline": "npm run build",
    "test:qa:offline": "playwright test --config playwright.offline.config.ts",
    "pretest:qa:keyboard": "python3 ../tools/sync_web_assets.py",
    "test:qa:keyboard": "playwright test --config playwright.qa.config.ts --grep '\\[qa:keyboard\\]'",
    "pretest:qa:puzzles": "python3 ../tools/sync_web_assets.py",
    "test:qa:puzzles": "playwright test --config playwright.qa.config.ts --grep '\\[qa:puzzles\\]'",
    "pretest:qa:responsive": "python3 ../tools/sync_web_assets.py",
    "test:qa:responsive": "playwright test --config playwright.qa.config.ts --grep '\\[qa:responsive\\]'",
    "pretest:qa:overlays": "python3 ../tools/sync_web_assets.py",
    "test:qa:overlays": "playwright test --config playwright.qa.config.ts --grep '\\[qa:overlays\\]'",
    "test:qa": "npm run test:qa:keyboard && npm run test:qa:puzzles && npm run test:qa:responsive && npm run test:qa:overlays && npm run test:qa:offline",
    "check:release": "node scripts/check-release-bundle.mjs",
    "validate:content": "python3 ../tools/validate_content.py",
    "assets:sync": "python3 ../tools/sync_web_assets.py",
    "assets:check": "python3 ../tools/sync_web_assets.py --check",
    "fonts:check": "python3 ../tools/check_font_glyphs.py"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "jsdom": "^29.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
