    {
      "id": "b_s130_origin",
      "sceneId": "s130",
      "groupId": "cg_s130",
      "label": "원본 판단 기록과 보고서의 생성 조건을 함께 제출 요구",
      "condition": [],
      "correct": true,
      "advances": true,
      "dialogue": [
        {
          "speaker": "조사관",
          "text": "원본 판단 기록과 이 보고서의 생성 조건을 함께 제출해 주십시오."
